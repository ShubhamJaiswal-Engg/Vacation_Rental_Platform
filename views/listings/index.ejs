<% layout("/layouts/boilerplate") %>
  <!-- <h3>All Listings</h3> -->
  <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
    <div class="container-fluid px-0 mt-2">
      <p class="mb-2">Search results for: <b><%= searchQuery %></b></p>
      <% if (allListing.length === 0) { %>
        <div class="alert alert-warning" role="alert">
          <div>No listings found.</div>
          <div class="mt-2">
            <a href="/listings" class="btn btn-outline-dark btn-sm">Go back to Home</a>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>

  <% const showResultsUI = !(typeof searchQuery !== 'undefined' && searchQuery && allListing.length === 0); %>
  <% if (showResultsUI) { %>
  <div class="filters d-none d-sm-flex flex-col  align-items-center gap-3">
    <div class="filter">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Tranding</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-bed"></i></div>
      <p>Home</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-mountain-city"></i></div>
      <p>iconic cities</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-mountain"></i></div>
      <p>mountain</p>
    </div>
    <div class="filter">
      <div><i class="fa-brands fa-fort-awesome"></i></div>
      <p>castles</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-campground"></i></div>
      <p>Camping</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-cow"></i></div>
      <p>Farms</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-snowflake"></i></div>
      <p>Arctic</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-igloo"></i></div>
      <p>Domes</p>
    </div>
        <div class="filter">
      <div><i class="fa-solid fa-person-swimming"></i></div>
      <p>Amazing pools</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-ferry"></i></div>
      <p>Boats</p>
    </div>

        <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
          <input class="form-check-input" type="checkbox" role="switch" id="taxToggleDesktop">
          <label class="form-check-label" for="taxToggleDesktop">Display after total taxes</label>
        </div>
        </div>
      </div>
      <div class="tax-toggle-container">
        <div class="tax-toggle-sm">
          <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="taxToggleMobile">
            <label class="form-check-label" for="taxToggleMobile">Display after total taxes</label>
          </div>
          </div>
        </div>
      <div class="row row-cols-xl-3 row-cols-md-2 row-cols-sm-1 mt-3" id="listing-grid">
        <% for (let listing of allListing) { %>
          <a href="/listings/<%= listing._id%>" class="listing-link" data-title="<%= (listing.title || '').toLowerCase() %>">
            <div class="card col  listing-card">
              <img src="<%= (listing.image && listing.image.url) ? listing.image.url.replace('/upload/', '/upload/f_auto,q_auto/') : '' %>" class="card-img-top" alt="listing_image" style="height: 20rem;" />
              <div class="card-img-overlay"></div>
              <div class="card-body">
                <p class="card-text mt-2">
                  <b>
                    <%= listing.title %>
                  </b>
                  <br>
                  &#8377;<%= listing.price%> /night
                  <i class="tax-info"> &nbsp;+18% GST</i>
                </p>
              </div>
            </div>
          </a>
          <% } %>
      </div>

      <% } %>

      <script>
        const taxSwitchDesktop = document.getElementById("taxToggleDesktop");
        const taxSwitchMobile = document.getElementById("taxToggleMobile");
        const toggles = [taxSwitchDesktop, taxSwitchMobile].filter(Boolean);

        function setTaxVisible(visible) {
          const taxInfo = document.getElementsByClassName("tax-info");
          for (const info of taxInfo) {
            info.style.display = visible ? "inline" : "none";
          }
          for (const t of toggles) {
            t.checked = visible;
          }
        }

        if (toggles.length) {
          // Initial state: respect whichever toggle is checked (default is false)
          setTaxVisible(toggles.some((t) => t.checked));

          for (const t of toggles) {
            t.addEventListener("change", (e) => {
              setTaxVisible(e.target.checked);
            });
          }
        }
      </script>